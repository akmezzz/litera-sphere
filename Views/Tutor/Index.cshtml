@model TutorPlatform.ViewModels.TutorDashboardViewModel
@{
    ViewData["Title"] = "Кабинет репетитора";
}

<section class="dashboard-hero-grid">
    <aside class="section-sidebar">
        <p class="eyebrow">Вкладки</p>
        <a class="section-square @(Model.ActiveTab == "overview" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="overview">
            <strong>Обзор</strong>
            <span>Кабинет</span>
        </a>
        @foreach (var examSection in Model.Sections)
        {
            <a class="section-square @(Model.ActiveSection?.Key == examSection.Key ? "section-square--active" : null)" asp-action="Section" asp-route-key="@examSection.Key">
                <strong>@examSection.Title</strong>
                <span>@examSection.AccentLabel</span>
            </a>
        }
        <a class="section-square section-square--soft @(Model.ActiveTab == "submissions" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="submissions">Работы</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "lessons" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="lessons">Уроки</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "creative" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="creative">Творчество</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "tips" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="tips">Советы</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "questions" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="questions">Вопросы</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "memes" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="memes">Мемы</a>
    </aside>

    <div class="dashboard-main-stack">
        <section class="dashboard-header dashboard-header--rich">
            <div>
                <span class="eyebrow">Кабинет репетитора</span>
                <h1>@Model.TutorName</h1>
                <p>Разделы вынесены на отдельные страницы, чтобы работа с платформой была чище и спокойнее.</p>
            </div>
            <div class="hero__actions">
                <a class="btn btn-accent" asp-action="CreateStudent">Новый ученик</a>
                <a class="btn btn-ghost" asp-action="CreateGroup">Новая группа</a>
                <a class="btn btn-ghost" asp-action="CreateTest">Новый тест</a>
                <a class="btn btn-ghost" asp-action="CreateCreativeTask">Творческое задание</a>
            </div>
        </section>

        @if (TempData["StatusMessage"] != null)
        {
            <div class="status-banner">@TempData["StatusMessage"]</div>
        }

        @if (Model.ActiveTab == "overview")
        {
            <section class="cards cards--stats">
                <article class="metric-card">
                    <span>Учеников</span>
                    <strong>@Model.TotalStudentsCount</strong>
                    <small>в активной базе</small>
                </article>
                <article class="metric-card">
                    <span>Групп</span>
                    <strong>@Model.TotalGroupsCount</strong>
                    <small>по потокам подготовки</small>
                </article>
                <article class="metric-card">
                    <span>Уроков</span>
                    <strong>@Model.TotalLessonsCount</strong>
                    <small>под контролем репетитора</small>
                </article>
                <article class="metric-card">
                    <span>Новых работ</span>
                    <strong>@Model.PendingReviewCount</strong>
                    <small>ожидают ручной проверки</small>
                </article>
            </section>

            <section class="quote-panel">
                <div>
                    <span class="eyebrow">Цитата дня</span>
                    <p>@Model.DailyQuote</p>
                </div>
                <div class="quote-panel__image">
                    <img src="@Model.DailyCatImageUrl" alt="Котик дня" />
                </div>
            </section>

            <section class="dashboard-grid">
                <article class="panel">
                    <div class="panel__header">
                        <h2>Главные блоки подготовки</h2>
                        <span>@Model.Sections.Count</span>
                    </div>
                    @foreach (var examSection in Model.Sections)
                    {
                        <a class="list-card list-card--link" asp-action="Section" asp-route-key="@examSection.Key">
                            <div class="badge-row">
                                <span class="tag">@examSection.Title</span>
                                <span class="tag">@examSection.AccentLabel</span>
                            </div>
                            <h3>@examSection.Description</h3>
                            <p class="muted">Подразделов: @examSection.Subsections.Count | Пробников: @examSection.MockExamCount</p>
                        </a>
                    }
                </article>

                <article class="panel">
                    <div class="panel__header">
                        <h2>Мемы с котиками</h2>
                        <a class="btn btn-ghost" asp-action="Index" asp-route-tab="memes">Открыть все</a>
                    </div>
                    @foreach (var meme in Model.Memes.Take(2))
                    {
                        <div class="meme-card">
                            <img src="@meme.ImageUrl" alt="@meme.Title" />
                            <div>
                                <h3>@meme.Title</h3>
                                <p>@meme.Caption</p>
                                <p class="muted">Лайков у учеников: @meme.LikeCount</p>
                            </div>
                        </div>
                    }
                </article>
            </section>
        }
        else if (Model.ActiveTab == "submissions")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Работы и выставленные баллы</h2>
                    <span>@Model.RecentSubmissions.Count</span>
                </div>
                @foreach (var submission in Model.RecentSubmissions)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@submission.ExamType</span>
                            @if (submission.IsReviewed)
                            {
                                <span class="tag tag--success">Проверено</span>
                            }
                            else
                            {
                                <span class="tag tag--warning">Ждет проверки</span>
                            }
                        </div>
                        <h3>@submission.StudentName</h3>
                        <p>@submission.TestTitle</p>
                        <p class="muted">Авто: @submission.AutoScore / @submission.MaxScore</p>
                        <p><strong>Итог:</strong> @(submission.TutorScore.HasValue ? $"{submission.TutorScore} / {submission.MaxScore}" : "еще не выставлен")</p>
                        <a class="btn btn-accent" asp-action="ReviewSubmission" asp-route-id="@submission.Id">Проверить</a>
                    </div>
                }
                @if (!Model.RecentSubmissions.Any())
                {
                    <p class="muted">Пока нет работ для проверки.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "lessons")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Уроки и конспекты</h2>
                    <span>@Model.Lessons.Count</span>
                </div>
                @foreach (var lesson in Model.Lessons)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@lesson.ExamType</span>
                            <span class="tag">@lesson.GroupName</span>
                            <span class="tag">@lesson.LessonFormat</span>
                        </div>
                        <h3>@lesson.Title</h3>
                        <p>@lesson.Theme</p>
                        <p class="muted">@lesson.Summary</p>
                        <form class="inline-form" asp-action="ToggleLessonVisibility" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="assignmentId" value="@lesson.AssignmentId" />
                            <button class="btn btn-ghost" type="submit">@(lesson.IsVisibleToStudent ? "Скрыть у ученика" : "Показать ученику")</button>
                        </form>
                    </div>
                }
                @if (!Model.Lessons.Any())
                {
                    <p class="muted">Пока уроки не добавлены.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "creative")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Творческие задания</h2>
                    <span>@Model.TotalCreativeTaskCount</span>
                </div>
                @foreach (var idea in Model.CreativeIdeas)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@idea.ExamType</span>
                        </div>
                        <h3>@idea.Title</h3>
                        <p>@idea.Prompt</p>
                    </div>
                }
                @if (!Model.CreativeIdeas.Any())
                {
                    <p class="muted">Пока творческие задания не созданы.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "tips")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Полезные советы</h2>
                    <span>@Model.Tips.Count</span>
                </div>
                @foreach (var tip in Model.Tips)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@tip.ExamType</span>
                        </div>
                        <h3>@tip.Title</h3>
                        <p>@tip.Description</p>
                    </div>
                }
                @if (!Model.Tips.Any())
                {
                    <p class="muted">Пока советы не добавлены.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "questions")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Вопросы от учеников</h2>
                    <span>@Model.StudentQuestions.Count</span>
                </div>
                @foreach (var question in Model.StudentQuestions)
                {
                    <div class="list-card">
                        <h3>@question.StudentName</h3>
                        <p><strong>@question.Topic</strong></p>
                        <p>@question.Message</p>
                        @if (question.IsAnswered)
                        {
                            <p><strong>Ответ:</strong> @question.TutorReply</p>
                        }
                        else
                        {
                            <form class="editor-form" asp-action="ReplyToQuestion" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="QuestionId" value="@question.Id" />
                                <textarea class="form-control" name="TutorReply" rows="3" placeholder="Ответ ученику, можно со смайликом"></textarea>
                                <button class="btn btn-accent" type="submit">Сохранить ответ</button>
                            </form>
                        }
                    </div>
                }
                @if (!Model.StudentQuestions.Any())
                {
                    <p class="muted">Пока вопросов от учеников нет.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "memes")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Мемы и расслабление</h2>
                    <span>@Model.Memes.Count</span>
                </div>
                @foreach (var meme in Model.Memes)
                {
                    <div class="meme-card">
                        <img src="@meme.ImageUrl" alt="@meme.Title" />
                        <div>
                            <h3>@meme.Title</h3>
                            <p>@meme.Caption</p>
                            <p class="muted">Лайков у учеников: @meme.LikeCount</p>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</section>
