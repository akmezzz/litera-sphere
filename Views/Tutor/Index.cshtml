@model TutorPlatform.ViewModels.TutorDashboardViewModel
@{
    ViewData["Title"] = "Кабинет репетитора";
}

<section class="dashboard-header">
    <div>
        <span class="eyebrow">Кабинет репетитора</span>
        <h1>@Model.TutorName</h1>
        <p>Создавайте учеников, собирайте группы, назначайте тесты и проверяйте работы по баллам.</p>
    </div>
    <div class="hero__actions">
        <a class="btn btn-accent" asp-action="CreateStudent">Новый ученик</a>
        <a class="btn btn-ghost" asp-action="CreateGroup">Новая группа</a>
        <a class="btn btn-ghost" asp-action="CreateTest">Новый тест</a>
    </div>
</section>

@if (TempData["StatusMessage"] != null)
{
    <div class="status-banner">@TempData["StatusMessage"]</div>
}

<section class="dashboard-grid">
    <article class="panel">
        <div class="panel__header">
            <h2>Проверенные и новые работы</h2>
            <span>@Model.RecentSubmissions.Count</span>
        </div>
        <p class="muted">Ожидают проверки: @Model.PendingReviewCount</p>
        @if (Model.RecentSubmissions.Any())
        {
            @foreach (var submission in Model.RecentSubmissions)
            {
                <div class="list-card">
                    <div class="badge-row">
                        @if (submission.IsReviewed)
                        {
                            <span class="tag tag--success">Проверено</span>
                        }
                        else if (submission.NeedsManualReview)
                        {
                            <span class="tag tag--warning">Нужна проверка</span>
                        }
                        else
                        {
                            <span class="tag">Автопроверка</span>
                        }
                    </div>
                    <h3>@submission.StudentName</h3>
                    <p>@submission.TestTitle</p>
                    <p class="muted">Авто: @submission.AutoScore / @submission.MaxScore</p>
                    @if (submission.TutorScore.HasValue)
                    {
                        <p><strong>Итог репетитора:</strong> @submission.TutorScore / @submission.MaxScore</p>
                    }
                    <p class="muted">Отправлено: @submission.SubmittedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    <a class="btn btn-accent" asp-action="ReviewSubmission" asp-route-id="@submission.Id">Открыть работу</a>
                </div>
            }
        }
        else
        {
            <p class="muted">Пока нет отправленных работ.</p>
        }
    </article>

    <article class="panel">
        <div class="panel__header">
            <h2>Зарегистрированные ученики</h2>
            <span>@Model.Students.Count</span>
        </div>
        @if (Model.Students.Any())
        {
            @foreach (var student in Model.Students)
            {
                <div class="list-card">
                    <h3>@student.Label</h3>
                    <p class="muted">Группы: @(student.GroupNames.Any() ? string.Join(", ", student.GroupNames) : "пока не назначены")</p>
                </div>
            }
        }
        else
        {
            <p class="muted">Пока нет зарегистрированных учеников.</p>
        }
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel">
        <div class="panel__header">
            <h2>Группы</h2>
            <span>@Model.Groups.Count</span>
        </div>
        @if (Model.Groups.Any())
        {
            @foreach (var group in Model.Groups)
            {
                <div class="list-card">
                    <div class="badge-row">
                        <h3>@group.Name</h3>
                        <a class="btn btn-ghost btn-sm" asp-action="EditGroup" asp-route-id="@group.Id">Редактировать</a>
                    </div>
                    <p>@group.Description</p>
                    <p class="muted">Ученики: @(group.StudentNames.Any() ? string.Join(", ", group.StudentNames) : "пока не добавлены")</p>
                </div>
            }
        }
        else
        {
            <p class="muted">Пока нет групп. Создайте первую и добавьте учеников.</p>
        }
    </article>

    <article class="panel">
        <div class="panel__header">
            <h2>Тесты</h2>
            <span>@Model.Tests.Count</span>
        </div>
        @if (Model.Tests.Any())
        {
            @foreach (var test in Model.Tests)
            {
                <div class="list-card">
                    <div class="badge-row">
                        <span class="tag">@test.ExamType</span>
                        <span class="tag">@test.MechanicType</span>
                        @if (test.IsPublished)
                        {
                            <span class="tag tag--success">Опубликован</span>
                        }
                    </div>
                    <h3>@test.Title</h3>
                    <p>@test.ModuleName</p>
                    <p class="muted">Назначено группам: @test.GroupCount | Отправлено работ: @test.SubmissionCount</p>
                </div>
            }
        }
        else
        {
            <p class="muted">Пока нет тестов. Откройте редактор и создайте первый сценарий.</p>
        }
    </article>
</section>
