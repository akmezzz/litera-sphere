@model TutorPlatform.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Кабинет ученика";
}

<section class="dashboard-hero-grid">
    <aside class="section-sidebar">
        <p class="eyebrow">Вкладки</p>
        <a class="section-square @(Model.ActiveTab == "overview" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="overview">
            <strong>Обзор</strong>
            <span>Кабинет</span>
        </a>
        @foreach (var examSection in Model.Sections)
        {
            <a class="section-square @(Model.ActiveSection?.Key == examSection.Key ? "section-square--active" : null)" asp-action="Section" asp-route-key="@examSection.Key">
                <strong>@examSection.Title</strong>
                <span>@examSection.AccentLabel</span>
            </a>
        }
        <a class="section-square section-square--soft @(Model.ActiveTab == "homework" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="homework">Домашка</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "results" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="results">Результаты</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "tips" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="tips">Советы</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "questions" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="questions">Вопросы</a>
        <a class="section-square section-square--soft @(Model.ActiveTab == "memes" ? "section-square--active" : null)" asp-action="Index" asp-route-tab="memes">Мемы</a>
    </aside>

    <div class="dashboard-main-stack">
        <section class="dashboard-header dashboard-header--rich">
            <div>
                <span class="eyebrow">Личный кабинет</span>
                <h1>@Model.StudentName</h1>
                <p>@Model.GradeLabel | Группы: @(Model.GroupNames.Any() ? string.Join(", ", Model.GroupNames) : "не назначены")</p>
            </div>
            <div class="hero__actions hero__actions--stacked">
                <span class="tag">Подготовка: @Model.PreparationMinutes мин.</span>
                <span class="tag">Пройдено уроков: @Model.CompletedLessonsCount</span>
                <span class="tag">Сдано работ: @Model.CompletedTestCount</span>
            </div>
        </section>

        @if (TempData["StatusMessage"] != null)
        {
            <div class="status-banner">@TempData["StatusMessage"]</div>
        }

        @if (Model.ActiveTab == "overview")
        {
            <section class="cards cards--stats">
                <article class="metric-card">
                    <span>Время подготовки</span>
                    <strong>@Model.PreparationMinutes</strong>
                    <small>примерно минут в системе</small>
                </article>
                <article class="metric-card">
                    <span>Уроков</span>
                    <strong>@Model.CompletedLessonsCount</strong>
                    <small>уже отмечены как завершенные</small>
                </article>
                <article class="metric-card">
                    <span>Работ</span>
                    <strong>@Model.CompletedTestCount</strong>
                    <small>отправлено на проверку</small>
                </article>
                <article class="metric-card">
                    <span>Любимых мемов</span>
                    <strong>@Model.LikedMemesCount</strong>
                    <small>котики снова на месте</small>
                </article>
            </section>

            <section class="quote-panel" id="quote-day">
                <div>
                    <span class="eyebrow">Цитата дня</span>
                    <p>@Model.DailyQuote</p>
                </div>
                <div class="quote-panel__image" id="cat-day">
                    <img src="@Model.DailyCatImageUrl" alt="Котик дня" />
                </div>
            </section>

            <section class="dashboard-grid">
                <article class="panel">
                    <div class="panel__header">
                        <h2>Основные блоки подготовки</h2>
                        <span>@Model.Sections.Count</span>
                    </div>
                    @foreach (var examSection in Model.Sections)
                    {
                        <a class="list-card list-card--link" asp-action="Section" asp-route-key="@examSection.Key">
                            <div class="badge-row">
                                <span class="tag">@examSection.Title</span>
                                <span class="tag">@examSection.AccentLabel</span>
                            </div>
                            <h3>@examSection.Description</h3>
                            <p class="muted">Подразделов: @examSection.Subsections.Count | Пробников: @examSection.MockExamCount</p>
                        </a>
                    }
                </article>

                <article class="panel">
                    <div class="panel__header">
                        <h2>Мемы с котиками</h2>
                        <a class="btn btn-ghost" asp-action="Index" asp-route-tab="memes">Открыть все</a>
                    </div>
                    @foreach (var meme in Model.Memes.Take(2))
                    {
                        <div class="meme-card">
                            <img src="@meme.ImageUrl" alt="@meme.Title" />
                            <div>
                                <h3>@meme.Title</h3>
                                <p>@meme.Caption</p>
                                <form class="inline-form" asp-action="ToggleMemeLike" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@meme.Id" />
                                    <button class="btn btn-ghost" type="submit">@(meme.IsLikedByCurrentStudent ? "Убрать из любимых" : "Лайкнуть")</button>
                                </form>
                            </div>
                        </div>
                    }
                </article>
            </section>
        }
        else if (Model.ActiveTab == "homework")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Домашнее задание</h2>
                    <span>@Model.HomeworkLessons.Count</span>
                </div>
                @foreach (var lesson in Model.HomeworkLessons)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@lesson.ExamType</span>
                            <span class="tag">@lesson.GroupName</span>
                        </div>
                        <h3>@lesson.Title</h3>
                        <p>@lesson.Homework</p>
                    </div>
                }
                @if (!Model.HomeworkLessons.Any())
                {
                    <p class="muted">Сейчас у тебя нет открытой домашки.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "results")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Результаты и проверка</h2>
                    <span>@Model.Results.Count</span>
                </div>
                @foreach (var result in Model.Results)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@result.ExamType</span>
                            @if (result.IsReviewed)
                            {
                                <span class="tag tag--success">Проверено</span>
                            }
                            else if (result.NeedsManualReview)
                            {
                                <span class="tag tag--warning">Ждет репетитора</span>
                            }
                        </div>
                        <h3>@result.Title</h3>
                        <p class="muted">Автоматическая часть: @result.AutoScore / @result.MaxScore</p>
                        @if (result.TutorScore.HasValue)
                        {
                            <p><strong>Итоговый балл:</strong> @result.TutorScore / @result.MaxScore</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(result.TutorFeedback))
                        {
                            <p><strong>Комментарий:</strong> @result.TutorFeedback</p>
                        }
                        <div class="hero__actions">
                            <a class="btn btn-ghost" asp-action="ResultDetails" asp-route-id="@result.SubmissionId">Открыть результат</a>
                        </div>
                    </div>
                }
                @if (!Model.Results.Any())
                {
                    <p class="muted">Пока нет отправленных и проверенных работ.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "tips")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Полезные советы</h2>
                    <span>@Model.Tips.Count</span>
                </div>
                @foreach (var tip in Model.Tips)
                {
                    <div class="list-card">
                        <div class="badge-row">
                            <span class="tag">@tip.ExamType</span>
                        </div>
                        <h3>@tip.Title</h3>
                        <p>@tip.Description</p>
                    </div>
                }
                @if (!Model.Tips.Any())
                {
                    <p class="muted">Пока полезные советы не добавлены.</p>
                }
            </section>
        }
        else if (Model.ActiveTab == "questions")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Вопросы и пожелания</h2>
                    <span>@Model.Questions.Count</span>
                </div>
                <form class="editor-form" asp-action="SendQuestion" method="post">
                    @Html.AntiForgeryToken()
                    <input class="form-control" name="Topic" placeholder="Например: не понял тему про деепричастный оборот" />
                    <textarea class="form-control" name="Message" rows="4" placeholder="Напиши вопрос, пожелание или то, что вызвало трудность"></textarea>
                    <button class="btn btn-accent" type="submit">Отправить репетитору</button>
                </form>
                @foreach (var question in Model.Questions)
                {
                    <div class="list-card">
                        <h3>@question.Topic</h3>
                        <p>@question.Message</p>
                        @if (question.IsAnswered)
                        {
                            <p><strong>Ответ:</strong> @question.TutorReply</p>
                        }
                        else
                        {
                            <span class="tag tag--warning">Ответ еще готовится</span>
                        }
                    </div>
                }
            </section>
        }
        else if (Model.ActiveTab == "memes")
        {
            <section class="panel">
                <div class="panel__header">
                    <h2>Мемы и котики</h2>
                    <span>@Model.Memes.Count</span>
                </div>
                @foreach (var meme in Model.Memes)
                {
                    <div class="meme-card">
                        <img src="@meme.ImageUrl" alt="@meme.Title" />
                        <div>
                            <div class="badge-row">
                                <span class="tag">@meme.Theme</span>
                                <span class="tag">Лайков: @meme.LikeCount</span>
                            </div>
                            <h3>@meme.Title</h3>
                            <p>@meme.Caption</p>
                            <form class="inline-form" asp-action="ToggleMemeLike" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@meme.Id" />
                                <button class="btn btn-ghost" type="submit">@(meme.IsLikedByCurrentStudent ? "Убрать из любимых" : "Лайкнуть и сохранить")</button>
                            </form>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</section>

